@page "/chat"

<PageTitle>Gear Chat Assistant - Northpeak Outfitters</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="14" Style="max-width: 900px; margin: 0 auto; height: 100%;">
    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Width="100%">
        <div>
            <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;">Northpeak AI Assistant</h2>
            <p style="margin: 4px 0 0 0; color: var(--neutral-foreground-hint); font-size: 0.9rem;">
                Ask technical product questions, check live stock, track customer orders, or consult store policies.
            </p>
        </div>
        <FluentBadge Appearance="Appearance.Accent" BackgroundColor="#107c41" Color="#ffffff">
            Online (Gemini Function Calling)
        </FluentBadge>
    </FluentStack>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Title="Chat Service Alert">
            @_errorMessage
        </FluentMessageBar>
    }

    <ChatWindow Messages="@_messages"
                IsWaiting="@_isWaiting"
                OnSendMessage="SendMessageAsync"
                OnResetSession="ResetSession" />
</FluentStack>
