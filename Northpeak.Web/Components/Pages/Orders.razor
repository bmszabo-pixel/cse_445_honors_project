@page "/orders"

<PageTitle>Order Lookup - Northpeak Outfitters</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="max-width: 860px; margin: 0 auto;">
    <div>
        <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;">Order Status & Tracking</h2>
        <p style="margin: 4px 0 0 0; color: var(--neutral-foreground-hint); font-size: 0.9rem;">
            Search any customer order by ID to inspect fulfillment progress, courier tracking, and estimated delivery dates.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Title="Order Lookup Issue">
            @_errorMessage
        </FluentMessageBar>
    }

    <FluentCard Style="padding: 24px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="14">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="12" Width="100%">
                <FluentTextField @bind-Value="@_searchOrderId"
                                 @onkeydown="HandleKeyDown"
                                 Label="Order ID"
                                 Placeholder="e.g. ORD-1001"
                                 Style="flex: 1;" />
                <FluentButton Appearance="Appearance.Accent" OnClick="SearchOrderAsync" Disabled="@_isLoading">
                    Lookup Order
                </FluentButton>
            </FluentStack>

            <div class="sample-orders-row">
                <span style="font-size: 0.8rem; color: var(--neutral-foreground-hint);">Sample order IDs:</span>
                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" OnClick="@(() => QuickSelectOrder("ORD-1001"))">
                    ORD-1001 (Shipped)
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" OnClick="@(() => QuickSelectOrder("ORD-1002"))">
                    ORD-1002 (Delivered)
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" OnClick="@(() => QuickSelectOrder("ORD-1003"))">
                    ORD-1003 (Processing)
                </FluentButton>
            </div>
        </FluentStack>
    </FluentCard>

    @if (_isLoading)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 40px;">
            <FluentProgressRing Size="ProgressRingSize.Medium" />
        </FluentStack>
    }
    else if (_hasSearched && _order == null && string.IsNullOrEmpty(_errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            No order found matching '@_lastSearchedId'. Please verify the order number (e.g. ORD-1001 through ORD-1008).
        </FluentMessageBar>
    }
    else if (_order != null)
    {
        <FluentCard Style="padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="18">
                <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Width="100%">
                    <div>
                        <h3 style="margin: 0; font-size: 1.25rem;">Order @_order.OrderId</h3>
                        <span style="font-size: 0.85rem; color: var(--neutral-foreground-hint);">Placed on @_order.OrderDate</span>
                    </div>
                    <OrderStatusBadge Status="@_order.Status" />
                </FluentStack>

                <FluentDivider />

                <div class="order-details-grid">
                    <div>
                        <div class="detail-label">Customer</div>
                        <div class="detail-value">@_order.CustomerName</div>
                    </div>
                    <div>
                        <div class="detail-label">Carrier</div>
                        <div class="detail-value">@_order.Carrier</div>
                    </div>
                    <div>
                        <div class="detail-label">Tracking Number</div>
                        <div class="detail-value"><code>@_order.TrackingNumber</code></div>
                    </div>
                    <div>
                        <div class="detail-label">Estimated Arrival (ETA)</div>
                        <div class="detail-value" style="font-weight: 600;">@_order.Eta</div>
                    </div>
                </div>

                <FluentDivider />

                <div>
                    <h4 style="margin: 0 0 10px 0; font-size: 1rem;">Items Ordered</h4>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        @foreach (var item in _order.Items)
                        {
                            <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Width="100%" Style="padding: 6px 0; border-bottom: 1px dashed var(--neutral-stroke-divider-rest);">
                                <span>@item.Quantity &times; @item.ProductName</span>
                                <span style="font-weight: 600;">$@((item.Quantity * item.Price).ToString("F2"))</span>
                            </FluentStack>
                        }
                    </FluentStack>
                </div>

                <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Width="100%" Style="padding-top: 8px;">
                    <span style="font-size: 1.1rem; font-weight: 700;">Order Total</span>
                    <span style="font-size: 1.25rem; font-weight: 800; color: var(--accent-fill-rest);">$@_order.Total.ToString("F2")</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }
</FluentStack>
