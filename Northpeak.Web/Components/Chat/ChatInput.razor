<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10" Width="100%">
    <FluentTextField @bind-Value="@_inputText"
                     @bind-Value:after="HandleInputChanged"
                     @onkeydown="HandleKeyDown"
                     Placeholder="Ask about gear specs, check stock, or track orders..."
                     Disabled="@IsDisabled"
                     Style="flex: 1;"
                     AutoComplete="off" />
    <FluentButton Appearance="Appearance.Accent"
                  OnClick="SendAsync"
                  Disabled="@(IsDisabled || string.IsNullOrWhiteSpace(_inputText))">
        Send ➤
    </FluentButton>
</FluentStack>
