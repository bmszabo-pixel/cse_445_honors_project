<FluentCard Style="padding: 16px; height: 100%; display: flex; flex-direction: column;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="height: 100%;">
        <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" Width="100%">
            <FluentBadge Appearance="Appearance.Neutral">@Product.Category</FluentBadge>
            <FluentBadge BackgroundColor="@StockBadgeBg" Color="#ffffff">@StockBadgeText</FluentBadge>
        </FluentStack>

        <h4 style="margin: 4px 0; font-size: 1.05rem;">@Product.Name</h4>

        <p style="margin: 0; font-size: 0.85rem; color: var(--neutral-foreground-hint); flex: 1 0 auto;">
            @Product.Description
        </p>

        <FluentDivider Style="margin: 8px 0;" />

        <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Width="100%">
            <span style="font-size: 1.15rem; font-weight: 600;">$@Product.Price.ToString("F2")</span>
            <span style="font-size: 0.8rem; color: var(--neutral-foreground-hint);">ID: @Product.Id</span>
        </FluentStack>
    </FluentStack>
</FluentCard>
